# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/

# Local cache (regeneratable from raw data via load_swale_dataset)
cache/

# Raw data dumps from the METER ZL6 portal (zips + unpacked CSVs).
# Treated as a working directory; canonical inputs live in /home/alexis/DATA/swale.
data/

# Plot outputs (regenerate via the numbered scripts under scripts/).
plots/

# Excel lock files (open spreadsheet in LibreOffice creates these).
.~lock.*#

# Third-party reference checkouts vendored under external/ (e.g. LGAR-Py).
external/

# Heavy upstream PDFs kept locally but not in repo history.
notes/Masters_thesis_*.pdf

# LaTeX build artifacts (only for our own writeups under notes/).
notes/*.aux
notes/*.log
notes/*.out
notes/*.fls
notes/*.fdb_latexmk
notes/*.synctex.gz
notes/*.toc

# Editor / OS
.vscode/
